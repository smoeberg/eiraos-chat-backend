# Required deployment configuration. Never commit real secrets.
POSTGRES_USER=eiraos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=eiraos_db
DATABASE_URL=postgresql+asyncpg://eiraos:replace-with-a-long-random-password@db:5432/eiraos_db
SECRET_KEY=replace-with-a-long-random-secret
CHAT_PROVIDER_TIMEOUT_SECONDS=60
CHAT_MAX_ATTEMPTS=3
