# Production deployment contract. Copy to .env, replace every placeholder,
# and never commit the resulting file or real secrets.
APP_ENV=production
RELEASE_SHA=replace-with-git-sha

POSTGRES_USER=eiraos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=eiraos_db
DATABASE_URL=postgresql+asyncpg://eiraos:replace-with-a-long-random-password@db:5432/eiraos_db
SECRET_KEY=change-me

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
TRUSTED_PROXY_CIDRS=replace-with-ingress-proxy-cidr

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

ALLOW_SYNC_INGEST_FALLBACK=false
ALLOW_PUBLIC_REGISTER=false
MAX_REQUEST_BODY_BYTES=2097152
MAX_UPLOAD_REQUEST_BODY_BYTES=11534336
CHAT_PROVIDER_TIMEOUT_SECONDS=60
CHAT_MAX_ATTEMPTS=3
PROVIDER_HTTP_MAX_ATTEMPTS=2
PROVIDER_HTTP_BACKOFF_SECONDS=0.1
PROVIDER_HTTP_MAX_RETRY_AFTER_SECONDS=2
